# Copy this file to `.env` and edit values before running `docker compose up`.
# `.env` is git-ignored.

# SQL Server SA password. Must satisfy SQL Server 2022 policy:
# 8+ chars including uppercase, lowercase, digit, and symbol.
DB_SA_PASSWORD=Devel0per!Strong

# JWT signing key — MUST be base64-encoded and decode to >= 32 bytes (256 bits) for HS256.
# Generate with:  openssl rand -base64 32
JWT_SIGNING_KEY=dGVzdC1qd3Qtc2lnbmluZy1rZXktZm9yLWludGVncmF0aW9uLXRlc3RzLTMyLWJ5dGVz

# Optional overrides
# ASPNETCORE_ENVIRONMENT=Development
# Cors__WebOrigin=http://localhost:4200
